// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      // "j k": ["workspace::SendKeystrokes", "escape"]
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-shift-u": "vim::ScrollUp",
      "ctrl-shift-d": "vim::ScrollDown",
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-shift-u z z"],
      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-shift-d z z"],
      "ctrl-shift-h": "pane::ActivatePreviousItem",
      "ctrl-shift-l": "pane::ActivateNextItem",
      "space p f": "file_finder::Toggle",
      "space p j": "workspace::NewSearch",
      "space c a": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-;": "vim::FirstNonWhitespace",
      "ctrl-'": "vim::EndOfLine",
      "ctrl-k": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "space s a": "vim::PushAddSurrounds",
      "space s c": "vim::PushChangeSurrounds",
      "space s d": "vim::PushDeleteSurrounds"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-=": ["zed::IncreaseBufferFontSize", { "persist": false }],
      "cmd--": ["zed::DecreaseBufferFontSize", { "persist": false }],
      "cmd-+": ["zed::IncreaseUiFontSize", { "persist": false }],
      "cmd-_": ["zed::DecreaseUiFontSize", { "persist": false }],
      "cmd-0": ["zed::ResetBufferFontSize", { "persist": false }]
    }
  }
]
